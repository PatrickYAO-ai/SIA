# Exemple de fichier .env — a copier en ".env" et a remplir avec tes propres
# valeurs Supabase (Settings > API Keys sur ton tableau de bord Supabase).
#
# Ce fichier .env.example, lui, EST versionne : il sert de modele pour
# quiconque reprend le projet, sans jamais exposer de vraie cle.

VITE_SUPABASE_URL=https://ton-projet.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
